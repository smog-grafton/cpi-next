# Public identity
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Christian Power Ministries International"

# MySQL. Leave DATABASE_URL empty to run public pages in read-only demonstration mode.
DATABASE_URL=mysql://cpmi_user:replace-me@127.0.0.1:3306/cpmi

# Authentication. Generate a long random value; never commit the real secret.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

# One-time bootstrap administrator. The password value must be a bcrypt hash.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=
ADMIN_BOOTSTRAP_ROLE=SUPER_ADMIN

# Streaming sources. The UI shows a truthful unavailable state when blank.
RADIO_PRIMARY_STREAM_URL=
RADIO_FALLBACK_STREAM_URL=
RADIO_STATION_NAME="CPMI Radio"
RADIO_STREAM_NAME="Kingdom Radio Stream"
RADIO_ARTWORK_URL=/assets/img/brand/cpmi/cpmi-radio-artwork.png
LIVE_VIDEO_HLS_URL=
LIVE_VIDEO_EMBED_URL=
HOMEPAGE_HERO_VIDEO_URL=

# Verified ministry details. Unset values are not displayed as facts.
MINISTRY_PUBLIC_EMAIL=
MINISTRY_PUBLIC_PHONE=
MINISTRY_ADDRESS=
MINISTRY_TIMEZONE=Africa/Johannesburg

# Verified giving instructions. Keep sensitive configuration server-side.
GIVING_METHOD_LABEL=
GIVING_INSTRUCTIONS=
GIVING_CURRENCY=ZAR
